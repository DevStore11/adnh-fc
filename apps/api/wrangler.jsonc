{
  "name": "adnh-fc",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/", "/jogadores", "/jogadores/*", "/jogos", "/jogos/*", "/estatisticas"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "adnh-fc-db",
      "database_id": "PREENCHER_AO_CRIAR",
      "migrations_dir": "../../migrations"
    }
  ]
}
